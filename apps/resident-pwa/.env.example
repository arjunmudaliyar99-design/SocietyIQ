# Copy to .env.local. Names only; no real values here. Only VITE_* reach the browser.
# Never put the Supabase service-role key in a front end (docs/04 §6).
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Usage analytics (M11); leave empty to disable (disabled in local, docs/04 §10)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Company identity (CLAUDE.md §4a)
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_PHONE=
VITE_SUPPORT_HOURS=
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_ADDRESS=
