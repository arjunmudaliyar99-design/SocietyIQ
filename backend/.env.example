# Copy to .env and fill in. Never commit .env. Names only; no real values here.
APP_ENV=local
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Database (M2): app runs as restricted role app_backend; migrations as owner
DATABASE_URL=
MIGRATIONS_DATABASE_URL=

# Supabase (M2). Service-role key is backend-only; never put it in a front end.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use whichever the Supabase project uses for JWT verification (docs/04 §5)
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
JWT_AUDIENCE=authenticated

# AI (docs/04 §11): fake | groq | gemini. Demo data only until Q-021 is answered.
AI_PROVIDER=fake
GROQ_API_KEY=
GEMINI_API_KEY=

# Email (M9). Provider not chosen yet.
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@example.com

# Scheduled jobs (docs/04 §13)
INTERNAL_JOBS_TOKEN=

# Company identity (CLAUDE.md §4a)
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=
SUPPORT_HOURS=
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=

# Invites and consent (M2)
INVITE_EXPIRY_DAYS=7
COMMITTEE_WEB_URL=http://localhost:5173
RESIDENT_PWA_URL=http://localhost:5174
POLICY_VERSION=draft-2026-10

# File storage (M3): local | supabase. Supabase uses SUPABASE_URL and the service-role key.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.storage
SUPABASE_STORAGE_BUCKET=society-files
